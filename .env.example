# Copia este archivo como .env y rellénalo. El .env NO se sube al repositorio.

# --- Desarrollo ------------------------------------------------------------
DEBUG=true
# En producción, una clave larga y aleatoria. Para generarla:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Sin DATABASE_URL se usa SQLite (db.sqlite3). Con PostgreSQL:
# DATABASE_URL=postgres://amh:LA_CONTRASEÑA@localhost:5432/amh

# Dónde corre el frontend (separados por comas si son varios).
ORIGENES_FRONTEND=http://localhost:5173
URL_PORTAL=http://localhost:5173/portal-de-pagos
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Correo -----------------------------------------------------------------
# Con DEBUG=true y sin nada de esto, los correos van a la BANDEJA LOCAL:
# se leen en http://localhost:8000/admin → "Bandeja de correos (local)".
# Con Resend (producción; necesita un dominio verificado):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=re_TU_API_KEY
# DEFAULT_FROM_EMAIL=AMH Solutions <no-responder@tudominio.com>
